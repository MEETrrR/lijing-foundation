# Production values are references and resource labels only; inject secrets from the production vault.
APP_ENV=production
CONFIG_SOURCE=example
APP_NAME=lijing-api
APP_VERSION=0.0.0-production
LOG_LEVEL=info

DATABASE_RESOURCE_ID=lijing-production-primary
DATABASE_NAME=lijing_production
DATABASE_CREDENTIAL_REF=secret://lijing/production/database

REDIS_RESOURCE_ID=lijing-production-cache
REDIS_NAMESPACE=lijing-production
REDIS_CREDENTIAL_REF=secret://lijing/production/redis

OBJECT_STORAGE_RESOURCE_ID=lijing-production-private
OBJECT_STORAGE_BUCKET=lijing-production-private
OBJECT_STORAGE_ENDPOINT=https://objects.production.example.invalid
OBJECT_STORAGE_CREDENTIAL_REF=secret://lijing/production/object-storage
OBJECT_STORAGE_PRIVATE=true

MESSAGE_BUS_RESOURCE_ID=lijing-production-events
MESSAGE_BUS_TOPIC=lijing-production-events
MESSAGE_BUS_CREDENTIAL_REF=secret://lijing/production/message-bus

AI_PROVIDER_PROJECT_ID=lijing-production-ai
AI_PROVIDER_CREDENTIAL_REF=secret://lijing/production/ai-provider
AI_BUDGET_ID=budget.lijing.production
AI_DAILY_BUDGET_CENTS=100000
AI_MONTHLY_BUDGET_CENTS=1000000
AI_ENABLED=true

SECRET_NAMESPACE=lijing/production
SECRET_PROVIDER_MODE=reference
TELEMETRY_ENABLED=true
TRACING_SAMPLE_RATE=0.1
DATABASE_POOL_MAX=25
CACHE_DEFAULT_TTL_SECONDS=600
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_DELAY_MS=500
REQUEST_TIMEOUT_MS=30000
