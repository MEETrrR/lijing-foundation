# Local development uses disposable synthetic data and in-memory or local adapters.
APP_ENV=local
CONFIG_SOURCE=example
APP_NAME=lijing-api
APP_VERSION=0.0.0-local
LOG_LEVEL=debug

DATABASE_RESOURCE_ID=lijing-local-primary
DATABASE_NAME=lijing_local
DATABASE_CREDENTIAL_REF=secret://lijing/local/database

REDIS_RESOURCE_ID=lijing-local-cache
REDIS_NAMESPACE=lijing-local
REDIS_CREDENTIAL_REF=secret://lijing/local/redis

OBJECT_STORAGE_RESOURCE_ID=lijing-local-private
OBJECT_STORAGE_BUCKET=lijing-local-private
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_CREDENTIAL_REF=secret://lijing/local/object-storage
OBJECT_STORAGE_PRIVATE=true

MESSAGE_BUS_RESOURCE_ID=lijing-local-events
MESSAGE_BUS_TOPIC=lijing-local-events
MESSAGE_BUS_CREDENTIAL_REF=secret://lijing/local/message-bus

AI_PROVIDER_PROJECT_ID=lijing-local-ai
AI_PROVIDER_CREDENTIAL_REF=secret://lijing/local/ai-provider
AI_BUDGET_ID=budget.lijing.local
AI_DAILY_BUDGET_CENTS=0
AI_MONTHLY_BUDGET_CENTS=0
AI_ENABLED=false

SECRET_NAMESPACE=lijing/local
SECRET_PROVIDER_MODE=in-memory
TELEMETRY_ENABLED=true
TRACING_SAMPLE_RATE=1
DATABASE_POOL_MAX=5
CACHE_DEFAULT_TTL_SECONDS=300
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_DELAY_MS=0
REQUEST_TIMEOUT_MS=30000
