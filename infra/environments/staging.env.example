# Staging uses dedicated synthetic data, credentials, resources, and a bounded AI budget.
APP_ENV=staging
CONFIG_SOURCE=example
APP_NAME=lijing-api
APP_VERSION=0.0.0-staging
LOG_LEVEL=info

DATABASE_RESOURCE_ID=lijing-staging-primary
DATABASE_NAME=lijing_staging
DATABASE_CREDENTIAL_REF=secret://lijing/staging/database

REDIS_RESOURCE_ID=lijing-staging-cache
REDIS_NAMESPACE=lijing-staging
REDIS_CREDENTIAL_REF=secret://lijing/staging/redis

OBJECT_STORAGE_RESOURCE_ID=lijing-staging-private
OBJECT_STORAGE_BUCKET=lijing-staging-private
OBJECT_STORAGE_ENDPOINT=https://objects.staging.example.invalid
OBJECT_STORAGE_CREDENTIAL_REF=secret://lijing/staging/object-storage
OBJECT_STORAGE_PRIVATE=true

MESSAGE_BUS_RESOURCE_ID=lijing-staging-events
MESSAGE_BUS_TOPIC=lijing-staging-events
MESSAGE_BUS_CREDENTIAL_REF=secret://lijing/staging/message-bus

AI_PROVIDER_PROJECT_ID=lijing-staging-ai
AI_PROVIDER_CREDENTIAL_REF=secret://lijing/staging/ai-provider
AI_BUDGET_ID=budget.lijing.staging
AI_DAILY_BUDGET_CENTS=5000
AI_MONTHLY_BUDGET_CENTS=25000
AI_ENABLED=true

SECRET_NAMESPACE=lijing/staging
SECRET_PROVIDER_MODE=reference
TELEMETRY_ENABLED=true
TRACING_SAMPLE_RATE=0.25
DATABASE_POOL_MAX=10
CACHE_DEFAULT_TTL_SECONDS=300
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_DELAY_MS=250
REQUEST_TIMEOUT_MS=30000
